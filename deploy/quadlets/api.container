[Unit]
After=timescaledb.service mosquitto.service
Wants=timescaledb.service mosquitto.service

[Container]
ContainerName=homescope-api
Image=ghcr.io/eldigh/homescope-api:latest
Network=homescope.network
AutoUpdate=registry
EnvironmentFile=%h/.config/homescope/api.env

# The KEK arrives as a tmpfs file, never as an environment variable — env would
# put it in /proc/<pid>/environ and in `podman inspect` output. KEK_PATH names
# the path; the secret itself is created once by deploy.sh (setup_kek).
Secret=homescope-kek,type=mount,target=kek,mode=0400
Environment=KEK_PATH=/run/secrets/kek

# The admin bearer token guarding /devices, delivered the same way and for the
# same reasons (setup_admin_token). Unlike the KEK it is regenerable: losing it
# costs a `podman secret rm` + rerun of deploy.sh, not a fleet re-provision.
Secret=homescope-admin-token,type=mount,target=admin-token,mode=0400
Environment=ADMIN_TOKEN_PATH=/run/secrets/admin-token

# 0.0.0.0 is the *container's* namespace, not the host's — the host-side
# exposure is decided entirely by PublishPort below. Binding loopback here
# would make the published port unreachable.
Environment=HTTP_BIND=0.0.0.0:3000

# Published on loopback only, so the bearer token never crosses the LAN in
# cleartext — there is no TLS terminator in front of this yet, and
# homescope-provision treats HTTPS as a hard requirement. Reach it from a
# workstation over an SSH tunnel:
#
#     ssh -N -L 4001:127.0.0.1:4001 <pi>
#     homescope-provision --api http://127.0.0.1:4001 ...
#
# Widen this to `4001:3000` only once something terminates TLS in front.
PublishPort=127.0.0.1:4001:3000

Environment=DB_HOST=homescope-db
Environment=DB_PORT=5432
Environment=DB_DATABASE=homescope
Environment=DB_POOL_MAX_CONNECTIONS=10
Environment=MQTT_HOST=homescope-mqtt
Environment=MQTT_PORT=1883
Environment=RUN_MIGRATIONS=true

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
