      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  d.name AS device,\n  g.prev_time AS \"gap start\",\n  g.time AS \"gap end\",\n  extract(epoch FROM g.time - g.prev_time) AS duration\nFROM (\n  SELECT\n    device_id,\n    time,\n    lag(time) OVER (PARTITION BY device_id ORDER BY time) AS prev_time\n  FROM readings\n  WHERE $__timeFilter(time) AND device_id IN (${device:csv})\n) g\nJOIN devices d ON d.id = g.device_id\nWHERE g.time - g.prev_time > interval '5 minutes'\nORDER BY g.prev_time DESC\nLIMIT 100",
          "refId": "A"
        }
      ],
      "title": "Reception gaps (> 5 min)",
      "type": "table"
    },
