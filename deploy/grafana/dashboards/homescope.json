      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  time_bucket_gapfill('$__interval'::interval, r.time) AS \"time\",\n  d.name AS metric,\n  avg(r.temp_degc) AS temperature\nFROM readings r\nJOIN devices d ON d.id = r.device_id\nWHERE $__timeFilter(r.time) AND r.device_id IN (${device:csv})\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        }
      ],
