#!/bin/bash
#
# homescope — day-to-day operation of a homescope host. Installed by
# deploy/deploy.sh to /usr/local/bin; run as root (sudo).
#
# usage: sudo homescope <command> [args]
#
#   status                         units and containers; failed units and where to look
#   logs <component> [journalctl args]   e.g. logs api -f, logs gateway -n 50
#   logs auto-update [journalctl args]   the image auto-update runs
#   start|stop|restart <component|all>
#   psql [psql args]               psql in the database, as postgres
#   podman <podman args>           podman as the homescope user
#   secret list                    which secrets are set
#   secret set <name>              from stdin, or a prompt on a terminal
#   secret show <name>             print one (backing up the KEK, reading the admin token)
#   secret rm <name>
#   backup                         an on-demand, timestamped database dump
#   backup --snapshot DIR          stable, uncompressed dump into DIR, for the
#                                  host's backup job to call before it runs
#   restore <dump> [--yes]         replace the database with a pg_dump archive
#   config                         the effective /etc/homescope/deploy.toml
#   shell [-c CMD]                 a shell as the homescope user, where
#                                  systemctl --user and podman work
#
# Components: api, db, grafana, gateway, mqtt, or all. Secrets: kek,
# admin-token, mqtt-api, mqtt-gateway.

set -euo pipefail

LIB_DIR=/usr/local/lib/homescope
if [[ ! -r $LIB_DIR/common.sh ]]; then
	echo "ERROR: $LIB_DIR/common.sh is missing — run deploy/deploy.sh first" >&2
	exit 1
fi
source "$LIB_DIR/common.sh"

usage() {
	sed -n '6,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
	exit "${1:-0}"
}

as_user_systemctl() {
	as_homescope systemctl --user "$@"
}

installed_units() {
	local file
	for file in "$QUADLET_DIR"/homescope-*.container; do
		[[ -e $file ]] && basename "$file" .container
	done
}

# `api` → homescope-api; `all` → every installed unit, in no particular order
# (systemd's dependencies order the starts).
units_for() {
	case "$1" in
		all) installed_units ;;
		api | db | grafana | gateway | mqtt)
			[[ -e "$QUADLET_DIR/homescope-$1.container" ]] ||
				die "this host does not run $1 (installed: $(installed_units | tr '\n' ' '))"
			echo "homescope-$1"
			;;
		*) die "unknown component: $1 (api, db, grafana, gateway, mqtt or all)" ;;
	esac
}

cmd_status() {
	# Without its data disk the user manager never starts (see deploy.sh,
	# setup_mount_dependency) — and then there is no user bus to ask.
	local manager
	manager="user@$(id -u "$HOMESCOPE_USER").service"
	if ! systemctl is-active --quiet "$manager"; then
		warn "the homescope user manager ($manager) is $(systemctl is-active "$manager"); no homescope service is running."
		warn "If data_dir is on a separate disk, is it mounted? See: systemctl status $manager"
		return 1
	fi

	as_user_systemctl list-units --all --no-pager 'homescope-*'
	echo
	homescope_podman ps --all --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}'

	# Every failed unit of the user manager, not just homescope-*: the
	# auto-update timer's service is the one that otherwise fails unseen.
	local failed unit
	failed="$(as_user_systemctl --failed --no-legend --plain | awk '{print $1}')"
	[[ -z $failed ]] || echo
	for unit in $failed; do
		case "$unit" in
			homescope-api.service | homescope-db.service | homescope-grafana.service | \
				homescope-gateway.service | homescope-mqtt.service)
				unit="${unit#homescope-}"
				warn "${unit%.service} failed — sudo homescope logs ${unit%.service}"
				;;
			podman-auto-update.service)
				warn "the image auto-update failed — sudo homescope logs auto-update"
				;;
			*)
				warn "$unit failed — sudo homescope shell -c 'systemctl --user status $unit'"
				;;
		esac
	done
}

# Container output (journald, tagged with the container name) together with
# the unit's own messages — a failed start shows up only in the latter.
#
# Read as root by field, scoped to the homescope user's uid: `journalctl
# --user` as that user sees its logs only when journald stores them on disk
# (per-user journal files exist only then), and `journalctl --user-unit` as
# root looks for root's units. `auto-update` is podman-auto-update.service,
# which the timer runs every 5 minutes.
cmd_logs() {
	[[ $# -ge 1 ]] || die "usage: homescope logs <component|all|auto-update> [journalctl args]"
	local list units
	if [[ $1 == auto-update ]]; then
		list=podman-auto-update
	else
		list="$(units_for "$1")"
	fi
	shift
	[[ -n $list ]] || die "no homescope units are installed on this host"
	mapfile -t units <<< "$list"

	local uid unit matches=()
	uid="$(id -u "$HOMESCOPE_USER")"
	for unit in "${units[@]}"; do
		matches+=(+ "_UID=$uid" "SYSLOG_IDENTIFIER=$unit"
			+ "_UID=$uid" "_SYSTEMD_USER_UNIT=$unit.service"
			+ "_UID=$uid" "USER_UNIT=$unit.service")
	done
	journalctl --no-hostname "${matches[@]:1}" "$@"
}

cmd_unit_verb() {
	local verb="$1"
	[[ $# -ge 2 ]] || die "usage: homescope $verb <component|all>"
	# Through a variable, not `< <(units_for …)`: a process substitution's
	# exit status is lost, so an unknown component would print its error and
	# then run the verb with no units at all.
	local list units
	list="$(units_for "$2")"
	[[ -n $list ]] || die "no homescope units are installed on this host"
	mapfile -t units <<< "$list"
	as_user_systemctl "$verb" "${units[@]/%/.service}"
}

cmd_psql() {
	local tty=(-i)
	[[ -t 0 && -t 1 ]] && tty=(-it)
	homescope_podman exec "${tty[@]}" homescope-db psql -U postgres -d homescope "$@"
}

# Only what an operator sets by hand; the broker's passwd and ACL are derived
# from the other secrets and from deploy.toml, and rebuilt by deploy.sh.
settable_secret() {
	case "$1" in
		kek | admin-token | mqtt-api | mqtt-gateway) echo "${SECRET_NAMES[$1]}" ;;
		mqtt-passwd | mqtt-acl) die "$1 is generated by deploy.sh from the other secrets and deploy.toml" ;;
		*) die "unknown secret: $1 (kek, admin-token, mqtt-api, mqtt-gateway)" ;;
	esac
}

cmd_secret() {
	local action="${1:-}" short="${2:-}" name
	case "$action" in
		list)
			for short in kek admin-token mqtt-api mqtt-gateway mqtt-passwd mqtt-acl; do
				name="${SECRET_NAMES[$short]}"
				if secret_exists "$name"; then
					printf '%-13s set, %s\n' "$short" \
						"$(homescope_podman secret inspect -f 'updated {{.UpdatedAt.Format "2006-01-02 15:04"}}' "$name")"
				else
					printf '%-13s not set\n' "$short"
				fi
			done
			;;

		set)
			[[ -n $short ]] || die "usage: homescope secret set <name>"
			name="$(settable_secret "$short")"
			if [[ $short == kek ]]; then
				# Replacing a KEK in use orphans every device key in the database.
				if secret_exists "$name"; then
					die "this host already has a KEK; replacing it orphans every device key. If that is really meant: homescope secret rm kek"
				fi
				if [[ -t 0 ]]; then
					die "pipe the KEK file in: sudo homescope secret set kek < kek-file"
				fi
			fi

			if [[ -t 0 ]]; then
				local value
				read -rsp "Value for $short (input hidden): " value
				echo
				[[ -n $value ]] || die "empty value; nothing set"
				printf '%s\n' "$value" | secret_put "$name"
			else
				secret_put "$name"
			fi
			log "Set $short."
			case "$short" in
				mqtt-api | mqtt-gateway)
					echo "    In the middle of a first deploy: run that deploy again. Already running: sudo homescope restart ${short#mqtt-}"
					echo "    (with a local broker, always rerun the deploy — it rebuilds the broker's password file)"
					;;
				admin-token) echo "    Apply it: sudo homescope restart api" ;;
				kek) echo "    Apply it: sudo homescope restart api" ;;
			esac
			;;

		show)
			[[ -n $short ]] || die "usage: homescope secret show <name>"
			name="${SECRET_NAMES[$short]:-}"
			[[ -n $name ]] || die "unknown secret: $short"
			if [[ -t 1 ]]; then
				warn "printing secret $short to the terminal"
			fi
			secret_value "$name"
			;;

		rm)
			[[ -n $short ]] || die "usage: homescope secret rm <name>"
			name="$(settable_secret "$short")"
			if [[ $short == kek ]]; then
				warn "Removing the KEK makes every device key in the database unreadable until the same KEK is imported again."
				local answer
				read -rp "Type the word 'orphan' to remove it: " answer
				[[ $answer == orphan ]] || die "not removed"
			fi
			homescope_podman secret rm "$name" > /dev/null
			log "Removed $short."
			;;

		*) die "usage: homescope secret list|set|show|rm [name]" ;;
	esac
}

# Replaces the database with a pg_dump archive — the restore procedure that was
# rehearsed against a production dump, as one command. Runs as root, so a
# root-only archive path works directly.
#
# The dump file is used as it is. The one step that differs from a textbook
# restore is CREATE EXTENSION *IF NOT EXISTS*: the timescaledb image installs
# the extension into template1, so the freshly created database already has it.
# timescaledb_pre_restore()/post_restore() bracket pg_restore so TimescaleDB's
# own catalog is restored as data, not re-created by its DDL hooks.
cmd_restore() {
	local file="" yes=false
	while (($#)); do
		case "$1" in
			--yes) yes=true ;;
			-*) die "unknown option: $1" ;;
			*)
				[[ -z $file ]] || die "usage: homescope restore <dump> [--yes]"
				file="$1"
				;;
		esac
		shift
	done
	[[ -n $file ]] || die "usage: homescope restore <dump> [--yes]"
	[[ -r $file ]] || die "cannot read $file"
	[[ -e "$QUADLET_DIR/homescope-db.container" ]] || die "this host does not run the database (the api component)"

	psql_postgres() {
		homescope_podman exec homescope-db psql -U postgres -v ON_ERROR_STOP=1 -qtA "$@"
	}

	# The `cat` drains what pg_restore --list leaves unread; without it podman
	# reports a failed write into the closed pipe although the archive is fine.
	# The exit status is pg_restore's own — a trailing `cat` would mask it.
	log "Checking $file"
	local listing
	# shellcheck disable=SC2016 # expanded by the container's shell
	listing="$(homescope_podman exec -i homescope-db sh -c \
		'pg_restore --list; status=$?; cat > /dev/null; exit $status' < "$file")" ||
		die "$file is not a pg_dump archive this database can read"
	grep -E '^;[[:space:]]+(Archive created at|dbname|Dumped from database version)' <<< "$listing" |
		sed 's/^;[[:space:]]*/    /'

	warn "This REPLACES the database on this host with $file — everything in it now is lost."
	if ! $yes; then
		local answer
		read -rp "Type 'restore' to continue: " answer
		[[ $answer == restore ]] || die "nothing changed"
	fi

	trap 'warn "Restore stopped part-way. The database may be incomplete or still in TimescaleDB restore mode, and the API is stopped. Fix the cause and run homescope restore again — it starts from scratch."' ERR

	local started
	started="$(date +%s)"

	log "Stopping the API, the only writer"
	as_user_systemctl stop homescope-api.service

	log "Recreating the database"
	psql_postgres -c 'DROP DATABASE IF EXISTS homescope WITH (FORCE)'
	psql_postgres -c 'CREATE DATABASE homescope OWNER api'
	psql_postgres -d homescope \
		-c 'CREATE EXTENSION IF NOT EXISTS timescaledb' -c 'SELECT timescaledb_pre_restore()' > /dev/null

	log "Restoring"
	homescope_podman exec -i homescope-db pg_restore -U postgres -d homescope < "$file"
	psql_postgres -d homescope -c 'SELECT timescaledb_post_restore()' > /dev/null
	trap - ERR

	log "Starting the API — it applies any newer migrations"
	as_user_systemctl start homescope-api.service

	local registry="" _
	for _ in $(seq 1 60); do
		registry="$(journalctl --no-hostname -o cat --since "@$started" SYSLOG_IDENTIFIER=homescope-api |
			sed 's/\x1b\[[0-9;]*m//g' | grep -m1 -oE '(device registry loaded|Error).*' || true)"
		[[ -n $registry ]] && break
		sleep 1
	done

	log "Restored:"
	psql_postgres -d homescope \
		-c "SELECT '    migrations applied: ' || count(*) FROM _sqlx_migrations" \
		-c "SELECT '    readings: ' || count(*) || ', newest ' || coalesce(max(time)::text, '-') FROM readings" \
		-c "SELECT '    devices: ' || count(*) FROM devices"
	echo "    API: ${registry:-no startup line yet — check: sudo homescope logs api}"
	if [[ $registry == *"could not be opened"* && $registry != *"(0 keys could not be opened)"* ]]; then
		warn "some device keys did not open — is this the KEK the dump was made under? (sudo homescope logs api)"
	fi
}

# An interactive shell as the homescope user — for whatever this command does
# not cover. A login shell in its home directory, with the environment cleared
# except for XDG_RUNTIME_DIR, which is what `systemctl --user` and rootless
# podman need and what `sudo -iu homescope` does not set ("Failed to connect to
# bus"). `machinectl shell homescope@` does the same with a full login session,
# but needs the systemd-container package.
cmd_shell() {
	XDG_RUNTIME_DIR="/run/user/$(id -u "$HOMESCOPE_USER")" \
		exec runuser --login "$HOMESCOPE_USER" --whitelist-environment=XDG_RUNTIME_DIR "$@"
}

# The host's backup job calls `homescope backup --snapshot DIR`; see
# backup-db.sh for why scheduling is the host's and not homescope's.
cmd_backup() {
	local CFG_BACKUP_DIR=/var/lib/homescope/backups
	if [[ -r $DEFAULT_CONFIG_FILE ]]; then
		load_config "$DEFAULT_CONFIG_FILE" "$LIB_DIR"
	fi
	BACKUP_DIR="$CFG_BACKUP_DIR" /usr/local/sbin/homescope-backup-db "$@"
}

main() {
	[[ $# -ge 1 ]] || usage 2
	local command="$1"
	shift

	case "$command" in
		help | -h | --help) usage ;;
	esac
	[[ $EUID -eq 0 ]] || die "run as root: sudo homescope $command $*"

	case "$command" in
		status) cmd_status ;;
		logs) cmd_logs "$@" ;;
		start | stop | restart) cmd_unit_verb "$command" "$@" ;;
		psql) cmd_psql "$@" ;;
		podman) homescope_podman "$@" ;;
		secret) cmd_secret "$@" ;;
		backup) cmd_backup "$@" ;;
		restore) cmd_restore "$@" ;;
		config) python3 "$LIB_DIR/config.py" --show "$DEFAULT_CONFIG_FILE" ;;
		shell) cmd_shell "$@" ;;
		*) die "unknown command: $command (see: homescope help)" ;;
	esac
}

main "$@"
