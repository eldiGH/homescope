# Mosquitto — the `broker` component: this host's own broker, for a single
# house running everything on one machine. Not published: only containers on
# homescope.network reach it.
#
# Authenticated like any production broker. The hashed password file and the
# ACL are generated by deploy.sh and delivered as podman secrets, which also
# hands them to the broker's own uid (1883) inside the user namespace — a bind
# mount would leave them owned by the homescope user and unreadable to it.
# The generated drop-in (homescope-mqtt.container.d/50-host.conf) adds the
# persistence bind mount under data_dir.
[Unit]
Description=homescope MQTT broker

[Container]
ContainerName=homescope-mqtt
Image=docker.io/eclipse-mosquitto:2-openssl
AutoUpdate=registry
Network=homescope.network
Volume=%h/.config/homescope/mosquitto.conf:/mosquitto/config/mosquitto.conf:ro
Secret=homescope-mqtt-passwd,type=mount,target=/mosquitto/config/passwd,uid=1883,gid=1883,mode=0400
Secret=homescope-mqtt-acl,type=mount,target=/mosquitto/config/acl,uid=1883,gid=1883,mode=0400

[Service]
# The first start pulls the image inside the unit; systemd's default 90 s can
# kill a large pull on a slow SD card.
TimeoutStartSec=900
Restart=on-failure

[Install]
WantedBy=default.target
