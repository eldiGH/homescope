          "rawQuery": true,
          "rawSql": "SELECT\n  d.name AS device,\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY r.rssi) AS rssi\nFROM readings r\nJOIN devices d ON d.id = r.device_id\nWHERE r.time > now() - interval '15 minutes' AND r.device_id IN (${device:csv})\nGROUP BY d.name\nORDER BY d.name",
